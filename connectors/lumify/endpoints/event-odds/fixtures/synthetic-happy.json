{
    "name": "synthetic-happy",
    "description": "SYNTHETIC \u2014 not recorded. Shape from GET /events/{event_id}/odds (lumify.ai/docs); the wire is the schema.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "https://lumify.ai/v1/events/12345/odds"
            },
            "res": {
                "status": 200,
                "body": {
                    "event_id": 12345,
                    "available": true,
                    "bookmaker": "pinnacle",
                    "markets": {
                        "moneyline": {
                            "home": -120,
                            "away": 105
                        }
                    }
                }
            }
        }
    ]
}
